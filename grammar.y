%{
#include <stdio.h>
#include <stdlib.h>

/*  Flex 分析函式與錯誤處理 */
int yylex(void);
void yyerror(const char *s);
%}

/* ========================================================================= */
/* 1. Token 宣告區                                                           */
/* ========================================================================= */
%token TRUE_VAL FALSE_VAL
%token AND_OP OR_OP NOT_OP
%token LPAREN RPAREN EOL

/* ========================================================================= */
/* 2. 優先權與結合律設定（越下方的優先權越高）                               */
/* ========================================================================= */
%left OR_OP          /* OR 優先權最低 */
%left AND_OP         /* AND 優先權中 */
%right NOT_OP   /* NOT 優先權最高  */

%%

/* ========================================================================= */
/* 3. 語法規則與 Action 計算區 (核心邏輯)                                    */
/* ========================================================================= */

/* 進入點：允許user輸入多行算式 */
input:
    /* 空白，代表什麼都沒輸入也算合法 */
    | input line
    ;

/* 可以是空行、正確的運算式、或是錯誤的輸入 */
line:
    EOL { /* 使用者只按 Enter，不動作 */ }
    | expr EOL { 
        /* 【難度 3 的核心】當成功解析完一條運算式，立刻執行 C 語言 Action 印出結果 */
        printf(" Result: %s\n\n", $1 ? "TRUE" : "FALSE"); 
      }
    | error EOL { 
        /* 語法錯誤時的復原機制，讓程式不會因為一個錯字就崩潰結束 */
        yyerrok; 
      }
    ;

/* 邏輯運算式的遞迴定義 */
expr:
    TRUE_VAL           { $$ = 1; }  /* 讀到 true，數值設為 1 */
    | FALSE_VAL         { $$ = 0; }  /* 讀到 false，數值設為 0 */
    | expr AND_OP expr  { $$ = $1 && $3; } /* 執行 C 語言的邏輯and */
    | expr OR_OP expr   { $$ = $1 || $3; } /* 執行 C 語言的邏輯or */
    | NOT_OP expr       { $$ = !$2; }      /* 執行 C 語言的邏輯not */
    | LPAREN expr RPAREN { $$ = $2; }      /* 剝掉括號，保留內部的計算結果 */
    ;

%%

/* ========================================================================= */
/* 4. C 語言副程式區                                                         */
/* ========================================================================= */

/* 當 Bison 發現輸入不符合語法規則時，會自動呼叫這個函式 */
void yyerror(const char *s) {
    fprintf(stderr, " Syntax Error: %s\n\n", s);
}

int main() {
    
    
    
    yyparse(); /* 啟動解析器 */
    return 0;
}